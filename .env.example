# Copy to .env (or export) for local work. Production values come from ECS task env/secrets.
DATABASE_URL=postgres://salon:salon@localhost:5432/salon
PORT=3000
# production: NODE_ENV=production turns on Secure cookies, HSTS, proxy headers (Caddy) and dist/web.
# NODE_ENV=production
# SECURE_COOKIES=true
# TRUST_PROXY=true
# MAX_UPLOAD_MB=8

# The AI mirror (customers try a cut on their photo). Off in production until a key is
# set; in development a built-in stand-in draws instead. Keep the key in a secret.
# AI_TRYON_PROVIDER=gemini            # gemini (default with a key) | openai | mock | none
# AI_TRYON_API_KEY=
# AI_TRYON_MODEL=                     # default gemini-2.5-flash-image / gpt-image-2
# AI_TRYON_PER_ADDRESS_10M=6
# AI_TRYON_PER_ADDRESS_DAILY=25
# AI_TRYON_SALON_DAILY=150
# AI_TRYON_DAILY=1500

# npm run seed
# Production: SEED_DOMAIN=salonak.app (the landing page; admin.salonak.app is the dashboard)
SEED_DOMAIN=localhost
SEED_BRAND_NAME=Salonak
SEED_BRAND_NAME_AR=صالونك
SEED_ADMIN_PHONE=+962790000000
# The platform's public contact: the landing page's WhatsApp button and the legal pages.
# Not the admin's sign-in number above (it would be published). Production shows no
# contact until this is set or the admin sets one in the dashboard; a re-seed changes a
# stored contact only when this is set.
# SEED_CONTACT_PHONE=+962790000099
SEED_ADMIN_PASSWORD=admin-pass-123
SEED_CALLING_CODE=962
SEED_TIMEZONE=Asia/Amman
SEED_CURRENCY=JOD
SEED_DEMO=true
